8.L1 Simulate the FCFS scheduling algorithm using C Programming.
COMMANDS / PROGRAM
/* fcfs.c */
#include <stdio.h>
int main() {
 int n, i, j, t, clk = 0;
 int pid[20], at[20], bt[20], ct[20], tat[20], wt[20];
 float tw = 0, tt = 0;
 printf("Number of processes: ");
 scanf("%d", &n);
 for (i = 0; i < n; i++) {
 pid[i] = i + 1;
 printf("P%d arrival time and burst time: ", i + 1);
 scanf("%d %d", &at[i], &bt[i]);
 }
 for (i = 0; i < n - 1; i++) /* sort by arrival time */
 for (j = 0; j < n - i - 1; j++)
 if (at[j] > at[j + 1]) {
 t = at[j]; at[j] = at[j + 1]; at[j + 1] = t;
 t = bt[j]; bt[j] = bt[j + 1]; bt[j + 1] = t;
 t = pid[j]; pid[j] = pid[j + 1]; pid[j + 1] = t;
 }
 for (i = 0; i < n; i++) {
 if (clk < at[i]) clk = at[i]; /* CPU idle until arrival */
 clk += bt[i];
 ct[i] = clk;
 tat[i] = ct[i] - at[i];
 wt[i] = tat[i] - bt[i];
 tw += wt[i];
 tt += tat[i];
 }
 printf("\nPID\tAT\tBT\tCT\tTAT\tWT\n");
 for (i = 0; i < n; i++)
 printf("P%d\t%d\t%d\t%d\t%d\t%d\n", pid[i], at[i], bt[i], ct[i], tat[i], wt[i]);
 printf("Average waiting time = %.2f\n", tw / n);
 printf("Average turnaround time = %.2f\n", tt / n);
 return 0;
}
