4.H3 Write a shell script to print all prime numbers in a given range.
COMMANDS / PROGRAM
#!/bin/bash
# primerange.sh
read -p 'Lower and upper limit: ' lo hi
for ((n=lo; n<=hi; n++)); do
 [ $n -lt 2 ] && continue
 p=1
 for ((i=2; i*i<=n; i++)); do
 [ $((n%i)) -eq 0 ] && { p=0; break; }
 done
 [ $p -eq 1 ] && echo -n "$n "
done
echo
