9.L2 Simulate a job queue for a. Implement FCFS and Round Robin scheduling algorithms. b. Each job
simulates training for a few epochs with random durations.
COMMANDS / PROGRAM
/* jobqueue.c (each job = random number of epochs, each epoch = random duration) */
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define N 5
int main() {
 int bt[N], rem[N], ct[N], i, e, tq = 4, clk, left;
 float w = 0, ta = 0;
 srand(time(NULL));
 for (i = 0; i < N; i++) {
 int epochs = rand() % 4 + 2;
 bt[i] = 0;
 printf("Job %d: %d epochs, durations:", i + 1, epochs);
 for (e = 0; e < epochs; e++) {
 int d = rand() % 5 + 1;
 printf(" %d", d);
 bt[i] += d;
 }
 printf(" => total %d\n", bt[i]);
 }
 clk = 0; /* FCFS: all jobs arrive at time 0 */
 for (i = 0; i < N; i++) { w += clk; clk += bt[i]; ta += clk; }
 printf("\nFCFS : avg wait=%.2f avg turnaround=%.2f\n", w / N, ta / N);
 for (i = 0; i < N; i++) rem[i] = bt[i];
 clk = 0; left = N; w = ta = 0;
 while (left) { /* Round Robin */
 for (i = 0; i < N; i++)
 if (rem[i] > 0) {
 int run = rem[i] < tq ? rem[i] : tq;
 clk += run;
 rem[i] -= run;
 if (rem[i] == 0) { ct[i] = clk; left--; }
 }
 }
 for (i = 0; i < N; i++) { ta += ct[i]; w += ct[i] - bt[i]; }
 printf("RR(q=%d) : avg wait=%.2f avg turnaround=%.2f\n", tq, w / N, ta / N);
 return 0;
}
