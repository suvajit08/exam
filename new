9.L1 Implement a solution to SJF, Priority Scheduling using c programming.
COMMANDS / PROGRAM
/* sjfprio.c (non-preemptive; a lower priority number means higher priority) */
#include <stdio.h>
int main() {
 int n, i, ch, clk = 0, done = 0;
 int at[20], bt[20], pr[20], ct[20], dn[20] = {0};
 float tw = 0, tt = 0;
 printf("1. SJF 2. Priority : ");
 scanf("%d", &ch);
 printf("Number of processes: ");
 scanf("%d", &n);
 for (i = 0; i < n; i++) {
 printf("P%d arrival burst priority: ", i + 1);
 scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
 }
 while (done < n) {
 int s = -1;
 for (i = 0; i < n; i++)
 if (!dn[i] && at[i] <= clk) {
 int key = (ch == 1) ? bt[i] : pr[i];
 int skey = (s == -1) ? 0 : ((ch == 1) ? bt[s] : pr[s]);
 if (s == -1 || key < skey) s = i;
 }
 if (s == -1) { clk++; continue; } /* CPU idle */
 clk += bt[s];
 ct[s] = clk;
 dn[s] = 1;
 done++;
 }
 printf("\nPID\tAT\tBT\tPR\tCT\tTAT\tWT\n");
 for (i = 0; i < n; i++) {
 int tat = ct[i] - at[i], wt = tat - bt[i];
 tw += wt;
 tt += tat;
 printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", i + 1, at[i], bt[i], pr[i], ct[i], tat, wt);
 }
 printf("Average waiting time = %.2f\n", tw / n);
 printf("Average turnaround time = %.2f\n", tt / n);
 return 0;
}
