4.L4 Write a shell script to check whether a given number is prime or not.
COMMANDS / PROGRAM
#!/bin/bash
# prime.sh
read -p 'Enter a number: ' n
p=1
[ $n -lt 2 ] && p=0
for ((i=2; i*i<=n; i++)); do
 [ $((n%i)) -eq 0 ] && { p=0; break; }
done
[ $p -eq 1 ] && echo "$n is prime" || echo "$n is not prime"
TERMINAL OUTPUT
