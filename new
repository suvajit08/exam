#!/bin/bash
# PART A: fcfs.sh - FCFS scheduler written in Bash
read -p 'Number of processes: ' n
for ((i=0; i<n; i++)); do
 id[i]=$((i+1))
 read -p "P$((i+1)) arrival burst priority: " at[i] bt[i] pr[i]
done
for ((i=0; i<n-1; i++)); do # sort by arrival time
 for ((j=0; j<n-i-1; j++)); do
 if (( at[j] > at[j+1] )); then
 t=${at[j]}; at[j]=${at[j+1]}; at[j+1]=$t
 t=${bt[j]}; bt[j]=${bt[j+1]}; bt[j+1]=$t
 t=${pr[j]}; pr[j]=${pr[j+1]}; pr[j+1]=$t
 t=${id[j]}; id[j]=${id[j+1]}; id[j+1]=$t
 fi
 done
done
clk=0; tw=0; tt=0
echo -e 'PID\tAT\tBT\tWT\tTAT'
for ((i=0; i<n; i++)); do
 (( clk < at[i] )) && clk=${at[i]}
 wt=$((clk-at[i])); clk=$((clk+bt[i])); tat=$((clk-at[i]))
 tw=$((tw+wt)); tt=$((tt+tat))
 echo -e "P${id[i]}\t${at[i]}\t${bt[i]}\t$wt\t$tat"
done
