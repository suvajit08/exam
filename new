8.L2 a. Implement Round Robin scheduling to serve each prompt. b. Log average wait time and turnaround time.
COMMANDS / PROGRAM
/* rr.c (enter the processes in order of arrival time) */
#include <stdio.h>
int main() {
 int n, tq, i, clk, done = 0, f = 0, r = 0;
 int at[20], bt[20], rem[20], ct[20], vis[20] = {0}, q[1000];
 float tw = 0, tt = 0;
 printf("Number of processes: ");
 scanf("%d", &n);
 for (i = 0; i < n; i++) {
 printf("P%d arrival and burst time: ", i + 1);
 scanf("%d %d", &at[i], &bt[i]);
 rem[i] = bt[i];
 }
 printf("Time quantum: ");
 scanf("%d", &tq);
 clk = at[0]; q[r++] = 0; vis[0] = 1;
 while (done < n) {
 if (f == r) { /* queue empty: jump to next arrival */
 for (i = 0; i < n; i++)
 if (!vis[i]) { clk = at[i]; q[r++] = i; vis[i] = 1; break; }
 }
 int p = q[f++];
 int run = rem[p] < tq ? rem[p] : tq;
 clk += run;
 rem[p] -= run;
 for (i = 0; i < n; i++) /* enqueue newly arrived processes */
 if (!vis[i] && at[i] <= clk) { q[r++] = i; vis[i] = 1; }
 if (rem[p] > 0) q[r++] = p;
 else { ct[p] = clk; done++; }
 }
 printf("\nPID\tAT\tBT\tCT\tTAT\tWT\n");
 for (i = 0; i < n; i++) {
 int tat = ct[i] - at[i], wt = tat - bt[i];
 tw += wt;
 tt += tat;
 printf("P%d\t%d\t%d\t%d\t%d\t%d\n", i + 1, at[i], bt[i], ct[i], tat, wt);
 }
 printf("Average waiting time = %.2f\n", tw / n);
 printf("Average turnaround time = %.2f\n", tt / n);
 return 0;
}
